def send_command(topic, value):
    client.publish(
        f"{TOPIC_BASE}/control/{topic}",
        str(value),)

btn_led.on_click(
    lambda event: send_command("led", 1))

btn_buzzer.on_click(
    lambda event: send_command("buzzer", 1))

slider_pan.param.watch(
    lambda event: send_command("pan", event.new),
    "value",)

slider_tilt.param.watch(
    lambda event: send_command("tilt", event.new),
    "value",)

temperature_indicator = pn.indicators.Gauge(
    name="🌡️ Temperature",
    value=0,
    bounds=(0, 60),)

humidity_indicator = pn.indicators.Gauge(
    name="💧 Humidity",
    value=0,
    bounds=(0, 100),)

lux_indicator = pn.indicators.Gauge(
    name="☀️ Light Intensity",
    value=0,
    bounds=(0, 2000),)

battery_indicator = pn.indicators.Gauge(
    name="🔋 Battery",
    value=0,
    bounds=(0, 15),)

live_table = pn.widgets.Tabulator(
    pd.DataFrame(),
    height=280,)

performance_table = pn.widgets.Tabulator(
    pd.DataFrame(),
    height=280,)

def update_indicators():
    temperature_indicator.value = latest_data["temperature"]
    humidity_indicator.value = latest_data["humidity"]
    lux_indicator.value = latest_data["lux"]
    battery_indicator.value = latest_data["battery"]

def update_live_table():
    temp = latest_data["temperature"]
    humidity = latest_data["humidity"]
    lux = latest_data["lux"]
    battery = latest_data["battery"]

    live_table.value = pd.DataFrame(
        {"Sensor": [
                "Temperature",
                "Humidity",
                "Light Intensity",
                "Battery Voltage",
                "Pan Angle",
                "Tilt Angle",],
            "Value": [f"{temp:.2f} °C",
                f"{humidity:.2f} %",
                f"{lux:.2f} lux",
                f"{battery:.2f} V",
                f"{latest_data['pan']}°",
                f"{latest_data['tilt']}°",],
            "Status": ["OK" if temp < 45 else "HIGH",
                "OK" if 30 <= humidity <= 70 else "CHECK",
                "GOOD" if lux > 500 else "LOW",
                "GOOD" if battery > 11 else "LOW",
                "ACTIVE",
                "ACTIVE",],})

def update_performance_table():
    irradiance = max(latest_data["lux"], 1)

    temperature = latest_data["temperature"]

    _, _, _, metrics = compute_iv_curve(
        w_panel_type.value,
        irradiance,
        temperature,)

    total_power = metrics["Pmpp"] * w_num_panels.value

    performance_table.value = pd.DataFrame(
        {"Metric": ["Open Circuit Voltage",
                "Short Circuit Current",
                "Maximum Power Voltage",
                "Maximum Power Current",
                "Panel Power",
                "Total System Power",
                "Efficiency",
                "Fill Factor",],
            "Value": [f"{metrics['Voc']:.2f} V",
                f"{metrics['Isc']:.2f} A",
                f"{metrics['Vmpp']:.2f} V",
                f"{metrics['Impp']:.2f} A",
                f"{metrics['Pmpp']:.2f} W",
                f"{total_power:.2f} W",
                f"{metrics['efficiency']:.2f} %",
                f"{metrics['fill_factor']:.2f}",],})

def create_environment_plot():
    if history_data.empty:
        return hv.Curve([])

    return history_data.hvplot.line(
        x="timestamp",
        y=["temperature", "humidity"],
        title="Live Temperature and Humidity",
        responsive=True,
        height=350,
        line_width=2,
        legend="top_left",)

def create_lux_plot():
    if history_data.empty:
        return hv.Curve([])

    return history_data.hvplot.line(
        x="timestamp",
        y="lux",
        title="Live Light Intensity",
        responsive=True,
        height=350,
        line_width=2,)

def create_battery_plot():
    if history_data.empty:
        return hv.Curve([])

    return history_data.hvplot.line(
        x="timestamp",
        y="battery",
        title="Live Battery Voltage",
        responsive=True,
        height=350,
        line_width=2,)

def create_iv_pv_plot():
    irradiance = max(latest_data["lux"], 1)

    temperature = latest_data["temperature"]

    voltage, current, power, metrics = compute_iv_curve(
        w_panel_type.value,
        irradiance,
        temperature,)

    iv_df = pd.DataFrame(
        {"Voltage": voltage,
            "Current": current,})

    pv_df = pd.DataFrame(
        {"Voltage": voltage,
            "Power": power,})

    iv_curve = iv_df.hvplot.line(
        x="Voltage",
        y="Current",
        title="I-V Curve",
        responsive=True,
        height=400,
        line_width=3,)

    pv_curve = pv_df.hvplot.line(
        x="Voltage",
        y="Power",
        title="P-V Curve",
        responsive=True,
        height=400,
        line_width=3,)

    if w_show_mpp.value:
        iv_curve *= hv.Points(
            [(metrics["Vmpp"], metrics["Impp"])]
        ).opts(size=10)

        pv_curve *= hv.Points(
            [(metrics["Vmpp"], metrics["Pmpp"])]
        ).opts(size=10)

    if w_plot_mode.value == "I-V Curve":
        return iv_curve

    if w_plot_mode.value == "P-V Curve":
        return pv_curve

    return (iv_curve + pv_curve).cols(2)

environment_plot = pn.bind(create_environment_plot)

lux_plot = pn.bind(create_lux_plot)

battery_plot = pn.bind(create_battery_plot)

iv_pv_plot = pn.bind(create_iv_pv_plot)

