conn = sqlite3.connect(
    "solar_dashboard.db",
    check_same_thread=False,)

cursor = conn.cursor()

cursor.execute("""
    CREATE TABLE IF NOT EXISTS sensor_data (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        timestamp TEXT,
        sensor TEXT,
        value REAL)""")

conn.commit()

MQTT_BROKER = "broker.hivemq.com"
MQTT_PORT = 1883
TOPIC_BASE = "epg317e/the_cyber_alchemists/smart_solar_tracker"

latest_data = {"temperature": 0,
    "humidity": 0,
    "lux": 0,
    "battery": 0,
    "pan": 90,
    "tilt": 90,}

history_data = pd.DataFrame(
    columns=[
        "timestamp",
        "temperature",
        "humidity",
        "lux",
        "battery",
        "pan",
        "tilt",])

MAX_HISTORY = 300

def insert_data(sensor, value):
    cursor.execute("""
        INSERT INTO sensor_data (
            timestamp,
            sensor,
            value)
        VALUES (?, ?, ?)
        """,
        (datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            sensor,
            value,),)

    conn.commit()

def on_connect(client, userdata, flags, rc):
    print(f"Connected to MQTT Broker: {rc}")

    client.subscribe(f"{TOPIC_BASE}/#")

def on_message(client, userdata, msg):
    global history_data

    topic = msg.topic
    payload = msg.payload.decode()

    try:
        value = float(payload)

        sensor = topic.split("/")[-1]

        if sensor in latest_data:
            latest_data[sensor] = value

            insert_data(sensor, value)

            row = {"timestamp": datetime.now(),
                "temperature": latest_data["temperature"],
                "humidity": latest_data["humidity"],
                "lux": latest_data["lux"],
                "battery": latest_data["battery"],
                "pan": latest_data["pan"],
                "tilt": latest_data["tilt"],}

            history_data = pd.concat(
                [
                    history_data,
                    pd.DataFrame([row]),
                ],
                ignore_index=True,)

            history_data = history_data.tail(MAX_HISTORY)

    except ValueError:
        print("Invalid MQTT payload")

client = mqtt.Client()

client.on_connect = on_connect
client.on_message = on_message

client.connect(
    MQTT_BROKER,
    MQTT_PORT,
    60,)

client.loop_start()

PANEL_SPECS = {"Monocrystalline": {
        "Isc": 9.5,
        "Voc": 40.0,
        "eff": 0.21,
        "temp_coeff_v": -0.0030,
        "temp_coeff_i": 0.0005,},
    "Polycrystalline": {
        "Isc": 9.0,
        "Voc": 37.5,
        "eff": 0.17,
        "temp_coeff_v": -0.0035,
        "temp_coeff_i": 0.0005,},
    "Thin-Film (CdTe)": {
        "Isc": 5.5,
        "Voc": 85.0,
        "eff": 0.13,
        "temp_coeff_v": -0.0025,
        "temp_coeff_i": 0.0004,},}

def compute_iv_curve(
    panel_type,
    irradiance,
    temperature,
    n_points=200,
):
    specs = PANEL_SPECS[panel_type]

    g_ratio = irradiance / 1000.0
    delta_t = temperature - 25.0

    isc = (specs["Isc"]* g_ratio* (1 + specs["temp_coeff_i"] * delta_t))

    voc = (specs["Voc"]* (1 + specs["temp_coeff_v"] * delta_t))

    if g_ratio > 0.01:
        voc += 0.5 * np.log(g_ratio)
    else:
        voc = 0
        isc = 0

    voc = max(voc, 0)
    isc = max(isc, 0)

    voltage = np.linspace(0, voc, n_points)

    if voc > 0 and isc > 0:
        a_value = voc / np.log(isc / 0.001 + 1)

        current = isc * (
            1 - np.exp((voltage - voc) / a_value))

        current = np.clip(current, 0, None)

    else:
        current = np.zeros_like(voltage)

    power = voltage * current

    idx = np.argmax(power)

    metrics = {"Voc": voc,
        "Isc": isc,
        "Vmpp": voltage[idx],
        "Impp": current[idx],
        "Pmpp": power[idx],
        "fill_factor": (
            power[idx] / (voc * isc)
            if voc * isc
            else 0),
        "efficiency": (
            (power[idx] / (irradiance * 1.7)) * 100
            if irradiance > 0
            else 0),}

    return voltage, current, power, metrics

w_system_name = pn.widgets.TextInput(
    name="System Name",
    value="The Cyber Alchemists Solar Tracker",)

w_panel_type = pn.widgets.Select(
